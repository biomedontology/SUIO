    <!-- http://purl.obolibrary.org/obo/OHS_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHS_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115>A process that acts intentionally to cause one&apos;s own death.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He, Jianhao Wang, Xiaofu Pan</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Suicide</obo:IAO_0000119>
        <rdfs:label xml:lang="en">suicide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHS_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHS_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHS_0000001"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/OHS_0000004"/>
        <obo:IAO_0000115>A suicide process that is attempted however does not acheive the suicide goal.</obo:IAO_0000115>
        <obo:IAO_0000117>Jiahao Wang, Oliver He</obo:IAO_0000117>
        <rdfs:label>suicide attempt</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHS_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHS_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHS_0000001"/>
        <obo:IAO_0000115>A suicide process that is conducted and achieves its goal of suicide (i.e., the person under suicide is deadline).</obo:IAO_0000115>
        <obo:IAO_0000117>Jiahao Wang, Oliver He</obo:IAO_0000117>
        <rdfs:label>suicide complete</rdfs:label>
    </owl:Class>
