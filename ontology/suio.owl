        <dc:description xml:lang="en">SUIO is a biomedical ontology in the domain of suicide.</dc:description>
        <dc:format xml:lang="en">OWL-DL</dc:format>
        <dc:subject xml:lang="en">Human population health</dc:subject>
        <dc:title xml:lang="en">SUIO: Suicide Ontology</dc:title>
        <owl:versionInfo xml:lang="en">Vision Release: 1.0.24</owl:versionInfo>
    </owl:Ontology>
    


