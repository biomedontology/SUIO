    <!-- http://purl.obolibrary.org/obo/RO_0002411 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002411">
        <rdfs:label xml:lang="en">causally upstream of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000002 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/SUIO_0000002">
        <obo:IAO_0000115>An object property that represents a relation between a phenotype and a genetic variation</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He, Jiahao Wang</obo:IAO_0000117>
        <rdfs:label xml:lang="en">phenotype susceptible to genetically variation of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000005 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/SUIO_0000005">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <obo:IAO_0000115>An object property that represents a relation betwen a genetic variation and a phenotype</obo:IAO_0000115>
        <rdfs:label>genetic variation for susceptibility to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000022 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/SUIO_0000022">
        <obo:IAO_0000112>A suicide process intends to achieve the suicide objective. However, this objective may be completed or failed.</obo:IAO_0000112>
        <obo:IAO_0000115>An object property that represents a relation between a planned process and its corresponding objective specification.</obo:IAO_0000115>
        <obo:IAO_0000117>Jie Zheng, Oliver He, Leo Yeh, Damayanthi Jesudas</obo:IAO_0000117>
        <rdfs:label xml:lang="en">intends to achieve objective</rdfs:label>
    </owl:ObjectProperty>
    


