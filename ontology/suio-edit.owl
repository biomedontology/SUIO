    <!-- http://purl.obolibrary.org/obo/SUIO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115>A process that acts intentionally to cause one&apos;s own death.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He, Jianhao Wang, Xiaofu Pan, Jie Zheng, Leo Yeh, Damayanthi Jesudas</obo:IAO_0000117>
        <obo:IAO_0000118>suicide</obo:IAO_0000118>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Suicide</obo:IAO_0000119>
        <rdfs:label xml:lang="en">suicidal behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SUIO_0000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/SUIO_0000022"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SUIO_0000021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/SUIO_0000004"/>
        <obo:IAO_0000115>A process that acts intentionally to cause one&apos;s own death. It is suicide process that is conducted and achieves its goal of suicide (i.e., the person under suicide is deadline).</obo:IAO_0000115>
        <obo:IAO_0000115>https://en.wikipedia.org/wiki/Suicide_attempt</obo:IAO_0000115>
        <obo:IAO_0000117>Jiahao Wang, Oliver He, Alex Diehl, Jie Zheng, Bill Duncan, Asiyah Lin</obo:IAO_0000117>
        <obo:IAO_0000118>act of suicide</obo:IAO_0000118>
        <obo:IAO_0000118>committing suicide</obo:IAO_0000118>
        <rdfs:label>suicide attempt</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000004">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SUIO_0000001"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002411"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000071"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SUIO_0000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002411"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000071"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A suicide behavior resulting in death of the person attempting suicide.</obo:IAO_0000115>
        <obo:IAO_0000115>https://en.wikipedia.org/wiki/Suicide</obo:IAO_0000115>
        <obo:IAO_0000117>Jiahao Wang, Oliver He, Alex Diehl, Jie Zheng, Bill Duncan, Asiyah Lin</obo:IAO_0000117>
        <obo:IAO_0000118>suicide complete</obo:IAO_0000118>
        <obo:IAO_0000118>suicide successful</obo:IAO_0000118>
        <rdfs:label>suicide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SUIO_0000001"/>
        <obo:IAO_0000115>suicidal ideation is a process that refers to the contemplation, thoughts, or fantasies of ending one&apos;s own life. It exists on a broad spectrum—ranging from fleeting thoughts (&quot;I wish I could disappear&quot;) to highly detailed, active plans. It is not a diagnosis, but rather a warning sign or symptom.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He</obo:IAO_0000117>
        <rdfs:label xml:lang="en">suicidal ideation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115>Suicide prevention refers to the collective efforts, policies, and interventions aimed at reducing the risk of suicide.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He</obo:IAO_0000117>
        <rdfs:label xml:lang="en">suicide prevention</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115>Suicide management refers to the clinical and practical strategies used to identify, assess, and treat individuals at risk of suicide.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He</obo:IAO_0000117>
        <rdfs:label xml:lang="en">suicide management</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115>Suicide treatment encompasses a combination of crisis intervention, targeted psychotherapy, and medication aimed at managing suicidal thoughts, reducing distress, and addressing underlying mental health conditions. The primary goal is to ensure immediate safety, build coping skills, and establish long-term reasons for living.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He</obo:IAO_0000117>
        <rdfs:label xml:lang="en">suicide treatment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SUIO_0000006"/>
        <obo:IAO_0000115>Thinking about death and having a specific intent, method, or defined plan to take your own life.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He, Anthony Huffman, Jie Zheng, Leo Yeh</obo:IAO_0000117>
        <rdfs:label xml:lang="en">active suicidal ideation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SUIO_0000006"/>
        <obo:IAO_0000115>A general desire to die or not wake up, but without a specific, actionable plan to carry out the death.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He, Anthony Huffman, Jie Zheng, Leo Yeh</obo:IAO_0000117>
        <rdfs:label xml:lang="en">passive suicidal ideation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:label xml:lang="en">risk factor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SUIO_0000012"/>
        <obo:IAO_0000115>Suicide risk factor is a risk factor with a biological, psychological, or environmental characteristic that increases the likelihood that a person will consider, attempt, or die by suicide. A suicide risk factor does not directly cause or predict suicide, but helps identify individuals who may be more vulnerable to suicidal crises.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He, Sam Smith, Jie Zheng, Leo Yeh</obo:IAO_0000117>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC3130348/</obo:IAO_0000119>
        <rdfs:label xml:lang="en">suicide risk factor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <obo:IAO_0000115>Protective factor is a disposition that is associated with a decreased probability that a particular disease or disorder will develop in an individual, that reduces the severity of an existing pathological condition, or that mitigates the effects of stress generally.</obo:IAO_0000115>
        <obo:IAO_0000117>Damayanthi Jesudas, Sam Smith, Jie Zheng, Oliver He, Leo Yeh</obo:IAO_0000117>
        <obo:IAO_0000119>https://dictionary.apa.org/protective-factor</obo:IAO_0000119>
        <rdfs:label xml:lang="en">protective factor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SUIO_0000014"/>
        <obo:IAO_0000115>Suicide protective factor is a protective factor of a personal or environmental characteristic that decreases the likelihood of suicidal behavior.</obo:IAO_0000115>
        <obo:IAO_0000117>Sam Smith, Oliver He, Jie Zheng, Leo Yeh, Damayanthi Jesudas</obo:IAO_0000117>
        <obo:IAO_0000118>protective factor for suicidal ideation</obo:IAO_0000118>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC11424721/</obo:IAO_0000119>
        <rdfs:label xml:lang="en">suicide protective factor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>Suicide related theory is an information content entity that focuses on suicide.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He, Anthony Huffman, Jie Zheng, Leo Yeh, Damayanthi Jesudas</obo:IAO_0000117>
        <rdfs:label xml:lang="en">suicide related theory</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ICO_0000078"/>
        <obo:IAO_0000115>Suicidality is the risk of suicide, usually indicated by suicidal ideation or intent, especially as evident in the presence of a well-elaborated suicidal plan.</obo:IAO_0000115>
        <obo:IAO_0000119>Sam Smith, Jie Zheng, Oliver He, Leo Yeh, Damayanthi Jesudas</obo:IAO_0000119>
        <obo:IAO_0000119>https://anderson.edu/student-life/counseling/suicidality</obo:IAO_0000119>
        <obo:IAO_0000119>https://dictionary.apa.org/suicidality</obo:IAO_0000119>
        <rdfs:label xml:lang="en">suicidality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SUIO_0000017"/>
        <obo:IAO_0000115>Adolescent suicidality is the suicidality in young, which encompasses thoughts of suicide (ideation), planning, and actual attempts.</obo:IAO_0000115>
        <obo:IAO_0000117>Sam Smith, Jie Zheng, Oliver He, Leo Yeh, Damayanthi Jesudas</obo:IAO_0000117>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC11424721/</obo:IAO_0000119>
        <rdfs:label xml:lang="en">adolescent suicidality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SUIO_0000016"/>
        <obo:IAO_0000115>The Interpersonal Theory of Suicide (IPTS) is a suicide related theory that is developed by psychologist Thomas Joiner and posits that the most dangerous form of suicidal desire is caused by the simultaneous presence of two interpersonal constructs: thwarted belongingness and perceived burdensomeness (and hopelessness about these states), and the capability to engage in suicidal behavior is separate from the desire to engage in suicidal behavior.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He, Anthony Huffman, Jie Zheng, Leo Yeh, Damayanthi Jesudas</obo:IAO_0000117>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC3130348/</obo:IAO_0000119>
        <rdfs:label xml:lang="en">The Interpersonal Theory of Suicide</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115>Voluntary stopping of eating and drinking (VSED) is a deliberate, self-initiated attempt to hasten death in the setting of suffering refractory to optimal palliative interventions or prolonged dying that a person finds intolerable.</obo:IAO_0000115>
        <obo:IAO_0000117>Sam Smith, Jie Zheng, Oliver He, Leo Yeh</obo:IAO_0000117>
        <obo:IAO_0000118>VSED</obo:IAO_0000118>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/29532465/</obo:IAO_0000119>
        <rdfs:label xml:lang="en">voluntary stopping of eating and drinking</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000117>Jie Zheng, Oliver He, Sam Smith, Leo Yeh</obo:IAO_0000117>
        <rdfs:label xml:lang="en">suicide objective</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:label xml:lang="en">desire</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SUIO_0000025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SUIO_0000025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SUIO_0000024"/>
