<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.obolibrary.org/obo/suio.owl#"
     xml:base="http://purl.obolibrary.org/obo/suio.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:doid="http://purl.obolibrary.org/obo/doid#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:subsets="http://purl.obolibrary.org/obo/ro/subsets#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/suio.owl">
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/suio/BFO_import.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/suio/HP_import.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/suio/IAO_import.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/suio/OGG_import.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/suio/OGSF_import.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/suio/PR_import.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/suio/RO_import.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/suio/gene-pheno.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/suio/gene-protein.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/suio/gene-sui.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/suio/pheno-gene.owl"/>
        <dc:creator xml:lang="en">Alex Diehl</dc:creator>
        <dc:creator>Anthony Huffman</dc:creator>
        <dc:creator>Asiyah Yu Lin</dc:creator>
        <dc:creator xml:lang="en">Bill Duncan</dc:creator>
        <dc:creator>Damayanthi Jesudas</dc:creator>
        <dc:creator>Jie Zheng</dc:creator>
        <dc:creator>John Beverley</dc:creator>
        <dc:creator>Leo Yeh</dc:creator>
        <dc:creator>Sam Smith</dc:creator>
        <dc:creator xml:lang="en">Yongqun &quot;Oliver&quot; He (YH)</dc:creator>
        <dc:date xml:lang="en">08-19-2026</dc:date>
        <dc:description xml:lang="en">SUIO is a biomedical ontology in the domain of suicide.</dc:description>
        <dc:format xml:lang="en">OWL-DL</dc:format>
        <dc:subject xml:lang="en">Human population health</dc:subject>
        <dc:title xml:lang="en">SUIO: Suicide Ontology</dc:title>
        <owl:versionInfo xml:lang="en">Vision Release: 1.0.37</owl:versionInfo>
    </owl:Ontology>
    


